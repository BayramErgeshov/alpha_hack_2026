# Copy to .env and fill locally. Never commit the real key.
ALFA_HOST=127.0.0.1
ALFA_PORT=8080
ALFA_DATA_DIR=data/input
ALFA_ANALYTICS_DIR=data/analytics
ALFA_NEWS_SEED=data/news/seed.json
ALFA_WORK_DIR=work
# Optional: built frontend directory served at / (Docker image uses /app/ui)
ALFA_STATIC_DIR=ui
# Optional: allow a local frontend dev server, e.g. http://localhost:5173
ALFA_CORS_ORIGIN=
# Optional bearer token for /api/v1/* (not the model key)
ALFA_API_TOKEN=
# Model gateway issued by the organizers (key stays on the backend only)
ALFA_LLM_API_KEY=
ALFA_LLM_BASE_URL=https://changellenge.up.railway.app/v1
ALFA_LLM_MODEL=deepseek/deepseek-v4.1-flash
ALFA_LLM_MODEL_FAST=google/gemma-4-26b-a4b-it
ALFA_LLM_MODEL_REVIEW=z-ai/glm-5.3-flash
ALFA_LLM_TIMEOUT_SECONDS=35
ALFA_LLM_DAILY_TOKEN_LIMIT=400000
ALFA_AGENT_SELF_CHECK=1
# Minutes between RSS refreshes; 0 disables background collection
ALFA_NEWS_REFRESH_MINUTES=30
